# Partial SSH config - included from ~/.ssh/config via setup.ts.
# Host-specific config (hostname, user, identity file) lives in ~/.ssh/config directly.

# Inside an inbound SSH session that forwarded an agent (ssh -A), prefer that
# forwarded agent over the local Secretive one, so git authenticates with the
# connecting client's keys. ssh keeps the first value seen for a keyword, so
# this must precede the "Host *" IdentityAgent below.
Match exec "test -n \"$SSH_CONNECTION\" && test -S \"$SSH_AUTH_SOCK\""
  IdentityAgent SSH_AUTH_SOCK

Host *
  # Reuse existing connections for subsequent SSH calls to the same host,
  # avoiding re-authentication. Socket closes when the last connection ends.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist no
  IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
